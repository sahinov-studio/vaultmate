{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VaultMate",
  "version": "1.1.0",
  "identifier": "com.vaultmate.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VaultMate",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Local-first encrypted credentials manager",
    "longDescription": "VaultMate is a local-first credentials manager that encrypts your passwords, API keys, and secrets with AES-256-GCM. It exposes a built-in MCP server so Claude Code and other AI assistants can read your credentials without you copy-pasting them.",
    "category": "Productivity",
    "copyright": "Copyright © 2026 VaultMate Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "VaultMate Contributors",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "startMenuFolder": "VaultMate"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/bittuai/vaultmate/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}